# Copy this file to .env before running the assistant.

# Choose one of: openai, gemini, mock
LLM_PROVIDER=mock

# OpenAI-compatible chat completions.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
OPENAI_BASE_URL=https://api.openai.com/v1

# Gemini REST API.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# Trino defaults are set in docker-compose.yml, override only for local runs.
TRINO_HOST=localhost
TRINO_PORT=8080
TRINO_USER=analyst
TRINO_CATALOG=iceberg
TRINO_SCHEMA=analytics
